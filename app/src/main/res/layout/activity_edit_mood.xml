<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/back1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center"
        android:padding="32dp">

        <!-- Title -->
        <TextView
            android:id="@+id/textViewEditMood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit/Delete Mood"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="24dp" />

        <!-- Mood Spinner -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Mood"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#6200EE"
            android:layout_marginBottom="16dp">

            <Spinner
                android:id="@+id/spinnerMood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/mood_array" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Edit Note -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Edit Note"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#6200EE"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Update Mood Button -->
        <Button
            android:id="@+id/btnUpdateMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Mood"
            android:textAllCaps="false"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-medium" />

        <!-- Delete Mood Button -->
        <Button
            android:id="@+id/btnDeleteMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Mood"
            android:textAllCaps="false"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-medium" />

        <!-- Back to Home Button -->
        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:backgroundTint="#B00020"
            android:textColor="#FFFFFF"
            android:padding="14dp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>
</ScrollView>